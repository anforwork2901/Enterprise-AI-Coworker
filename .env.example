# ─── LLM Provider Selection ──────────────────────────────────────────────────
# Set to "gemini" or "openai". The engine will auto-detect if left unset.
LLM_PROVIDER=gemini

# ─── Google Gemini (default provider) ────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL=gemini-2.5-flash

# ─── OpenAI (alternative provider) ───────────────────────────────────────────
# To use OpenAI instead, set LLM_PROVIDER=openai and fill in these values:
# OPENAI_API_KEY="your-openai-api-key-here"
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Shared LLM Parameters ────────────────────────────────────────────────────
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1024

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ─── Vector Store ────────────────────────────────────────────────────────────
FAISS_INDEX_PATH=data/faiss_index
# Gemini embedding model (used when LLM_PROVIDER=gemini)
EMBEDDING_MODEL=models/gemini-embedding-001

# ─── Persona & Data Paths ────────────────────────────────────────────────────
PERSONAS_DIR=personas
KNOWLEDGE_BASE_DIR=data/knowledge_base
